# ---------------------------------------------------------------------------
# PayPal Sandbox (poi Live) — nomi attesi da IthaPayPal + api/paypal-* + serverEnv
# ---------------------------------------------------------------------------
# Client (browser): solo questo. Deve essere il Client ID Sandbox dell’app REST.
# Non lasciare "sb" in sviluppo reale: è un placeholder demo, non la tua app.
VITE_PAYPAL_CLIENT_ID=
# Server (api/paypal-create-order, api/paypal-capture-order):
# Preferito: stesso Client ID anche come PAYPAL_CLIENT_ID (opzionale; se vuoto usa VITE_).
# PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live  → api-m.sandbox.paypal.com | api-m.paypal.com
PAYPAL_ENV=sandbox
# Webhook ID da PayPal Developer → Webhooks
# URL: https://www.tarotitalia.com/api/paypal-webhook
PAYPAL_WEBHOOK_ID=

# Soglia pubblica in produzione (Vercel). In `npm run dev` è sempre disattivata.
# Token live: ?access=tarot2026
VITE_SITE_GATE=true
VITE_SITE_ACCESS=tarot2026
ITHA_GROQ_API_KEY=tua_chiave_groq_qui
# Opzionale. Se vuoto: tenta Llama 3.3 70B, poi openai/gpt-oss-120b.
# ITHA_GROQ_MODEL=llama-3.3-70b-versatile
# Chat widget — solo server. Non esporre al client (niente VITE_).
TAROTCHAT_GROQ_API_KEY=tua_chiave_tarotchat_groq_qui
# Opzionale. Se vuoto: Llama 3.3 70B, poi openai/gpt-oss-120b.
# TAROTCHAT_GROQ_MODEL=openai/gpt-oss-120b
# Opzionale. Se vuoto, Telegram usa il numero ufficiale dello Studio.
# VITE_TELEGRAM_URL=https://t.me/+393791038253

# ---------------------------------------------------------------------------
# Supabase — client (VITE_) + server (service role)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opzionale (stesso valore della publishable key, se usi il nuovo naming)
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Alias server opzionali (se VITE_ non sono letti in qualche ambiente):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Solo server. Non esporre nel client. Necessaria per crediti dopo PayPal.
SUPABASE_SERVICE_ROLE_KEY=
# Recensioni Google (Places Details, solo server)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
