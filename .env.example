# Soglia pubblica in produzione (Vercel). In `npm run dev` è sempre disattivata.
# Token live: ?access=tarot2026
VITE_SITE_GATE=true
VITE_SITE_ACCESS=tarot2026

ITHA_GROQ_API_KEY=tua_chiave_groq_qui
# Opzionale. Se vuoto: tenta Llama 3.3 70B, poi openai/gpt-oss-120b.
# ITHA_GROQ_MODEL=llama-3.3-70b-versatile
# Chat widget — solo server. Non esporre al client (niente VITE_).
TAROTCHAT_GROQ_API_KEY=tua_chiave_tarotchat_groq_qui
# Opzionale. Se vuoto: Llama 3.3 70B, poi openai/gpt-oss-120b.
# TAROTCHAT_GROQ_MODEL=openai/gpt-oss-120b
# Opzionale. Se vuoto, Telegram usa il numero ufficiale dello Studio.
# VITE_TELEGRAM_URL=https://t.me/+393791038253

# ---------------------------------------------------------------------------
# Supabase — client (VITE_) + server (service role)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Opzionale (stesso valore della publishable key, se usi il nuovo naming)
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Alias server opzionali (se VITE_ non sono letti in qualche ambiente):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Solo server (API che richiedono privilegi elevati).
SUPABASE_SERVICE_ROLE_KEY=
# Stripe Checkout (solo server / Edge Functions — mai VITE_)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://www.tarotitalia.com
# Recensioni Google (Places Details, solo server)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
